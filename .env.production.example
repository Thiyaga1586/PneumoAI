APP_NAME=PneumoAI
ENV=production

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

MODEL_DEVICE=cpu
DEFAULT_MODEL_VERSION=v1

MODELS_DIR=models
RUNTIME_DIR=/app/data/runtime
SQLITE_PATH=/app/data/runtime/requests.db
DATABASE_URL=postgresql://pneumoai:pneumoai_password@postgres:5432/pneumoai

INFERENCE_BACKEND=local
TRITON_ENABLED=false
TRITON_URL=localhost:8001
TRITON_FALLBACK_TO_LOCAL=true

MAX_UPLOAD_MB=10
ADMIN_API_KEY=replace-with-long-random-secret

MLFLOW_TRACKING_URI=sqlite:////app/data/runtime/mlflow.db
MLFLOW_EXPERIMENT_NAME=pneumoai

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_KEY=pneumoai:queue:predict
WORKER_POLL_INTERVAL_SECONDS=1.0

CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.com