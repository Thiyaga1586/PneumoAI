name: "pneumonia_classifier"
platform: "onnxruntime_onnx"
max_batch_size: 16

input [
  {
    name: "input_image"
    data_type: TYPE_FP32
    dims: [1, 224, 224]
  }
]

output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [1]
  }
]

dynamic_batching {
  preferred_batch_size: [4, 8, 16]
  max_queue_delay_microseconds: 5000
}